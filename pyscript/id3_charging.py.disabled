"""
id3_charging.py — DÉSACTIVÉ (volkswagencarnet opérationnel)
Version CarConnectivity MQTT (addon Pulpyyyy/carconnectivity-addon)
Pour réactiver : supprimer les lignes @state_trigger ci-dessous ou renommer en .py

Entités clés :
  switch.id3_start_stop_charging              — démarre/stoppe la charge
  button.id3_wakeup                           — wake-up (remplace force_data_refresh)
  binary_sensor.id3_charging_connector_lock_state
  sensor.id3_soc_primary                      — niveau batterie (%)
  sensor.id3_charging_state                   — état charge
  number.id3_charging_target_level            — cible batterie (%)
  sensor.lixee_current_price                  — HEURE CREUSE / HEURE PLEINE
  sensor.surplus_solaire_moyen_5_min          — surplus solaire (W)
  input_number.car_battery_max                — seuil max batterie (%)
  input_number.solar_surplus_min              — surplus min pour charge solaire (W)
  input_boolean.car_smart_charging            — killswitch charge HC
  input_boolean.car_solar_charging            — killswitch charge solaire
"""

CABLE     = "binary_sensor.id3_charging_connector_lock_state"
BAT_LVL   = "sensor.id3_soc_primary"
BAT_TGT   = "number.id3_charging_target_level"
CHG_SW    = "switch.id3_start_stop_charging"
CHG_STATE = "sensor.id3_charging_state"
WAKEUP    = "button.id3_wakeup"
PRIX      = "sensor.lixee_current_price"
SURPLUS   = "sensor.surplus_solaire_moyen_5_min"
BAT_MAX   = "input_number.car_battery_max"
SOL_MIN   = "input_number.solar_surplus_min"
SMART     = "input_boolean.car_smart_charging"
SOLAR     = "input_boolean.car_solar_charging"
TRACKER   = "device_tracker.id3_position"

_last_solar_notif = 0  # timestamp dernière notif solaire


def _wakeup():
    """Wake-up + attente courte pour état frais."""
    button.press(entity_id=WAKEUP)
    task.sleep(30)


def _bat() -> float:
    return float(state.get(BAT_LVL) or 0)

def _bat_max() -> float:
    return float(state.get(BAT_MAX) or 80)

def _surplus() -> float:
    return float(state.get(SURPLUS) or 0)

def _sol_min() -> float:
    return float(state.get(SOL_MIN) or 1500)

def _at_home() -> bool:
    return state.get(TRACKER) == "home"

def _cable_ok() -> bool:
    # connector_lock_state = locked → câble verrouillé = branché
    return state.get(CABLE) == "on"

def _charging_on() -> bool:
    return state.get(CHG_SW) == "on"

def _notify(title, msg):
    service.call("notify", "mobile_app_pixel_9a", title=title, message=msg)


# ── Heures Creuses → démarrer la charge ──────────────────────────────────────

@state_trigger(f"{PRIX} == 'HEURE CREUSE'")
def id3_start_hc(**kwargs):
    if state.get(SMART) != "on":
        return

    if not _at_home():
        log.info("[id3_charging] HC — voiture hors domicile, skip")
        return

    if not _cable_ok():
        log.info("[id3_charging] HC — câble non connecté, skip")
        return

    _wakeup()

    bat = _bat()
    if bat >= _bat_max():
        log.info(f"[id3_charging] HC — batterie déjà à {bat}% >= max {_bat_max()}%, skip")
        return

    if _charging_on():
        log.info("[id3_charging] HC — charge déjà active, skip")
        return

    switch.turn_on(entity_id=CHG_SW)
    log.info(f"[id3_charging] HC — charge démarrée ({bat}%)")
    _notify("🔌 Charge ID.3", f"Début de charge HC ({bat}%)")
    task.sleep(5)
    button.press(entity_id=WAKEUP)


# ── Heures Pleines → stopper la charge ───────────────────────────────────────

@state_trigger(f"{PRIX} == 'HEURE PLEINE'")
def id3_stop_hp(**kwargs):
    if state.get(SMART) != "on":
        return

    if not _charging_on():
        return

    # Si surplus solaire suffisant → on laisse charger
    if _surplus() >= _sol_min():
        log.info(f"[id3_charging] HP — surplus solaire {_surplus()}W suffisant, charge maintenue")
        return

    switch.turn_off(entity_id=CHG_SW)
    bat = _bat()
    log.info(f"[id3_charging] HP — charge arrêtée ({bat}%)")
    _notify("⏸ Charge ID.3", f"Fin des heures creuses ({bat}%)")
    task.sleep(5)
    button.press(entity_id=WAKEUP)


# ── Batterie max atteinte → stopper ──────────────────────────────────────────

@state_trigger(f"{BAT_LVL}")
def id3_stop_battery_full(**kwargs):
    if not _charging_on():
        return

    if _bat() < _bat_max():
        return

    switch.turn_off(entity_id=CHG_SW)
    bat = _bat()
    log.info(f"[id3_charging] Batterie max atteinte ({bat}%), charge arrêtée")
    _notify("⏸ Charge ID.3", f"Batterie pleine ({bat}%)")
    task.sleep(5)
    button.press(entity_id=WAKEUP)


# ── Surplus solaire → démarrer la charge ─────────────────────────────────────

@state_trigger(f"{SURPLUS}")
def id3_solar_charge(**kwargs):
    surplus = _surplus()

    if state.get(SOLAR) != "on":
        return

    if not _at_home():
        return

    if not _cable_ok():
        return

    bat = _bat()
    bat_tgt = float(state.get(BAT_TGT) or 100)

    global _last_solar_notif
    now = task.time()
    throttle = 300  # 5 min entre deux notifs solaires

    if surplus >= _sol_min() and bat < bat_tgt:
        if not _charging_on():
            switch.turn_on(entity_id=CHG_SW)
            log.info(f"[id3_charging] Solaire — charge démarrée ({surplus}W surplus, {bat}%)")
            if now - _last_solar_notif >= throttle:
                _notify("☀ Charge ID.3", f"Charge sur surplus solaire activée ({int(surplus)}W)")
                _last_solar_notif = now

    elif surplus < 10 and _charging_on():
        # Ne stoppe que si HC n'est pas actif — sinon c'est HC qui gère
        if not (state.get(PRIX) == "HEURE CREUSE" and state.get(SMART) == "on"):
            switch.turn_off(entity_id=CHG_SW)
            log.info(f"[id3_charging] Solaire — surplus insuffisant ({surplus}W), charge arrêtée")
            if now - _last_solar_notif >= throttle:
                _notify("🌥 Charge ID.3", f"Surplus insuffisant, charge arrêtée ({int(surplus)}W)")
                _last_solar_notif = now
            task.sleep(5)
            button.press(entity_id=WAKEUP)
