# ═══════════════════════════════════════════════════════════════════════════
#  COPILOTE WOLVERINE — Insuline (CRITIQUE, 7j/7)
#  Rappel injection matin + soir pour Wolverine (chat diabétique).
#  Canal : bot Telegram @Ha_maison_chris_bot (notify.maison_maison_chris).
#  Log   : /config/logs/wolverine_insuline.jsonl (service pyscript.log_insuline).
#
#  LOGIQUE
#   - MATIN : déclenché quand le Sonos chambre passe playing→paused/idle dans la
#     fenêtre 6h45–9h30 (= ton lever après l'alarme). Filet de sécurité à 9h30
#     (couvre week-end : l'alarme Sonos est WEEKDAYS seulement).
#   - Au clic « Fait » : log JSONL + programme le rappel SOIR à +12h pile.
#   - SOIR : +12h après la confirmation du matin.
#   - ESCALADE (santé = pas de pitié) : relance toutes les 15 min jusqu'à
#     confirmation. « Snooze » = re-ping dans 15 min.
#   - ABSENCE : si presence_maison=off à l'heure → message d'alerte spécial.
#
#  Helpers, automations et timer sont tous préfixés `insuline_` / « 💉 ».
# ═══════════════════════════════════════════════════════════════════════════

# ── Helpers ─────────────────────────────────────────────────────────────────
input_boolean:
  insuline_matin_faite:
    name: 💉 Insuline matin faite
    icon: mdi:needle
  insuline_soir_faite:
    name: 💉 Insuline soir faite
    icon: mdi:needle
  insuline_en_cours:
    name: 💉 Nudge insuline en cours
    icon: mdi:bell-ring
  insuline_escalade_declenchee:
    name: 💉 Escalade insuline déclenchée (= en retard)
    icon: mdi:bell-alert
  # ── Mira (Amodip 1j/2) ──
  mira_amodip_faite:
    name: 💊 Amodip Mira faite (aujourd'hui)
    icon: mdi:pill
  mira_en_cours:
    name: 💊 Nudge Amodip Mira en cours
    icon: mdi:bell-ring
  mira_escalade_declenchee:
    name: 💊 Escalade Amodip Mira déclenchée (= en retard)
    icon: mdi:bell-alert
  # ── Chris (traitements perso matin/soir) ──
  chris_matin_faite:
    name: 🧑 Médocs matin Chris faits
    icon: mdi:pill-multiple
  chris_soir_faite:
    name: 🧑 Médocs soir Chris faits
    icon: mdi:pill-multiple
  chris_en_cours:
    name: 🧑 Nudge médocs Chris en cours
    icon: mdi:bell-ring
  chris_escalade_declenchee:
    name: 🧑 Escalade médocs Chris déclenchée (= en retard)
    icon: mdi:bell-alert
  # ── Rappel mensuel chats (1er du mois : antipuce + filtre fontaine) ──
  chats_mensuel_fait:
    name: 🐱 Rappel mensuel chats fait (ce mois)
    icon: mdi:calendar-check
  # ── Hydratation/repas (contextuel : 3h de stream continu) ──
  hydratation_nudge_envoye:
    name: 🥤 Nudge hydratation déjà envoyé (cette session stream)
    icon: mdi:cup-water

input_datetime:
  insuline_heure_matin:
    name: 💉 Heure injection matin (pour +12h)
    has_date: true
    has_time: true

input_number:
  insuline_snoozes:
    name: 💉 Compteur snooze insuline
    min: 0
    max: 20
    step: 1
    mode: box
    icon: mdi:counter
  mira_snoozes:
    name: 💊 Compteur snooze Amodip Mira
    min: 0
    max: 20
    step: 1
    mode: box
    icon: mdi:counter
  chris_snoozes:
    name: 🧑 Compteur snooze médocs Chris
    min: 0
    max: 20
    step: 1
    mode: box
    icon: mdi:counter

input_text:
  insuline_moment_courant:
    name: 💉 Moment du nudge en cours
    max: 10          # "matin" | "soir"
  insuline_source_courante:
    name: 💉 Source du nudge en cours
    max: 16          # sonos | filet_0930 | plus12h | manuel
  chris_moment_courant:
    name: 🧑 Moment du nudge médocs Chris en cours
    max: 10          # "matin" | "soir"

timer:
  insuline_relance:
    name: 💉 Relance insuline (escalade 15 min)
    duration: "00:15:00"
    restore: true
  mira_relance:
    name: 💊 Relance Amodip Mira (escalade 15 min)
    duration: "00:15:00"
    restore: true
  chris_relance:
    name: 🧑 Relance médocs Chris (escalade 15 min)
    duration: "00:15:00"
    restore: true

# ── Automations ─────────────────────────────────────────────────────────────
automation:
  # 1) Reset quotidien des flags à 00h05 ────────────────────────────────────
  - id: insuline_reset_quotidien
    alias: 💉 Insuline - Reset quotidien
    trigger:
      - platform: time
        at: "00:05:00"
    action:
      - service: input_boolean.turn_off
        target:
          entity_id:
            - input_boolean.insuline_matin_faite
            - input_boolean.insuline_soir_faite
            - input_boolean.insuline_en_cours
            - input_boolean.insuline_escalade_declenchee
            - input_boolean.mira_amodip_faite
            - input_boolean.mira_en_cours
            - input_boolean.mira_escalade_declenchee
            - input_boolean.chris_matin_faite
            - input_boolean.chris_soir_faite
            - input_boolean.chris_en_cours
            - input_boolean.chris_escalade_declenchee
            - input_boolean.hydratation_nudge_envoye
      - service: timer.cancel
        target:
          entity_id:
            - timer.insuline_relance
            - timer.mira_relance
            - timer.chris_relance

  # 1bis) Reset MENSUEL du flag rappel chats (le 1er à 00h06) ────────────────
  - id: chats_reset_mensuel
    alias: 🐱 Chats - Reset mensuel (1er)
    trigger:
      - platform: time
        at: "00:06:00"
    condition:
      - condition: template
        value_template: "{{ now().day == 1 }}"
    action:
      - service: input_boolean.turn_off
        target:
          entity_id: input_boolean.chats_mensuel_fait

  # 2) Détection du lever via Sonos (playing → paused/idle, fenêtre 6h45–9h30) ─
  - id: insuline_detection_lever_sonos
    alias: 💉 Insuline - Détection lever (Sonos)
    trigger:
      - platform: state
        entity_id: media_player.chambre
        from: "playing"
        to: "paused"
      - platform: state
        entity_id: media_player.chambre
        from: "playing"
        to: "idle"
    condition:
      - condition: time
        after: "06:45:00"
        before: "09:30:00"
      - condition: state
        entity_id: input_boolean.insuline_matin_faite
        state: "off"
      - condition: state
        entity_id: input_boolean.insuline_en_cours
        state: "off"
    action:
      - service: script.insuline_envoyer_nudge
        data:
          moment: "matin"
          source: "sonos"
      # même lever → nudge médocs Chris du matin (si pas déjà fait/en cours)
      - if:
          - condition: state
            entity_id: input_boolean.chris_matin_faite
            state: "off"
          - condition: state
            entity_id: input_boolean.chris_en_cours
            state: "off"
        then:
          - service: script.chris_envoyer_nudge
            data:
              moment: "matin"
      # le 1er du mois → nudge mensuel chats (antipuce + filtre fontaine)
      - if:
          - condition: template
            value_template: "{{ now().day == 1 }}"
          - condition: state
            entity_id: input_boolean.chats_mensuel_fait
            state: "off"
        then:
          - service: script.chats_envoyer_nudge_mensuel

  # 3) Filet de sécurité matin à 9h30 (week-end / Sonos muet) ────────────────
  - id: insuline_filet_matin_0930
    alias: 💉 Insuline - Filet matin 9h30
    trigger:
      - platform: time
        at: "09:30:00"
    condition:
      - condition: state
        entity_id: input_boolean.insuline_matin_faite
        state: "off"
    action:
      - service: script.insuline_envoyer_nudge
        data:
          moment: "matin"
          source: "filet_0930"
      # filet aussi pour le rappel mensuel chats (1er du mois)
      - if:
          - condition: template
            value_template: "{{ now().day == 1 }}"
          - condition: state
            entity_id: input_boolean.chats_mensuel_fait
            state: "off"
        then:
          - service: script.chats_envoyer_nudge_mensuel

  # 4) Rappel SOIR : +12h après l'injection du matin ────────────────────────
  #    Vérifié toutes les 5 min ; part quand on a dépassé heure_matin + 12h.
  - id: insuline_rappel_soir
    alias: 💉 Insuline - Rappel soir (+12h)
    trigger:
      - platform: time_pattern
        minutes: "/5"
    condition:
      - condition: state
        entity_id: input_boolean.insuline_matin_faite
        state: "on"          # le matin a été confirmé → heure_matin est valide
      - condition: state
        entity_id: input_boolean.insuline_soir_faite
        state: "off"
      - condition: state
        entity_id: input_boolean.insuline_en_cours
        state: "off"
      - condition: template
        value_template: >-
          {{ now() >= (states('input_datetime.insuline_heure_matin') | as_datetime | as_local
                       + timedelta(hours=12)) }}
    action:
      - service: script.insuline_envoyer_nudge
        data:
          moment: "soir"
          source: "plus12h"

  # 5) ESCALADE : le timer de relance a expiré sans confirmation ─────────────
  - id: insuline_escalade
    alias: 💉 Insuline - Escalade (relance 15 min)
    trigger:
      - platform: event
        event_type: timer.finished
        event_data:
          entity_id: timer.insuline_relance
    condition:
      - condition: state
        entity_id: input_boolean.insuline_en_cours
        state: "on"
    action:
      - service: input_boolean.turn_on
        target:
          entity_id: input_boolean.insuline_escalade_declenchee
      - service: script.insuline_envoyer_nudge
        data:
          moment: "{{ states('input_text.insuline_moment_courant') }}"
          source: "{{ states('input_text.insuline_source_courante') }}"
          relance: true

  # 6) Handler « Fait ✅ » (callback Telegram /INSU_OK) ──────────────────────
  - id: insuline_handler_fait
    alias: 💉 Insuline - Handler « Fait »
    trigger:
      - platform: event
        event_type: telegram_callback
        event_data:
          data: "/INSU_OK"
    action:
      # 1. stoppe l'escalade
      - service: timer.cancel
        target:
          entity_id: timer.insuline_relance
      # 2. log JSONL via pyscript
      - service: pyscript.log_insuline
        data:
          moment: "{{ states('input_text.insuline_moment_courant') }}"
          source: "{{ states('input_text.insuline_source_courante') }}"
          snoozes: "{{ states('input_number.insuline_snoozes') | int(0) }}"
          en_retard: "{{ is_state('input_boolean.insuline_escalade_declenchee', 'on') }}"
      # 3. marque le moment fait + si MATIN, mémorise l'heure pour le +12h
      - choose:
          - conditions:
              - condition: template
                value_template: "{{ states('input_text.insuline_moment_courant') == 'matin' }}"
            sequence:
              - service: input_boolean.turn_on
                target:
                  entity_id: input_boolean.insuline_matin_faite
              - service: input_datetime.set_datetime
                target:
                  entity_id: input_datetime.insuline_heure_matin
                data:
                  datetime: "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"
          - conditions:
              - condition: template
                value_template: "{{ states('input_text.insuline_moment_courant') == 'soir' }}"
            sequence:
              - service: input_boolean.turn_on
                target:
                  entity_id: input_boolean.insuline_soir_faite
      # 4. fin du nudge + reset compteur snooze + flag escalade
      - service: input_boolean.turn_off
        target:
          entity_id:
            - input_boolean.insuline_en_cours
            - input_boolean.insuline_escalade_declenchee
      - service: input_number.set_value
        target:
          entity_id: input_number.insuline_snoozes
        data:
          value: 0
      # 5. accusé de réception Telegram
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: >-
            ✅ Noté. Injection {{ states('input_text.insuline_moment_courant') }} loggée. Merci pour Wolverine. 🐾

  # 7) Handler « Snooze ⏱️ » (callback Telegram /INSU_SNOOZE) ────────────────
  - id: insuline_handler_snooze
    alias: 💉 Insuline - Handler « Snooze »
    trigger:
      - platform: event
        event_type: telegram_callback
        event_data:
          data: "/INSU_SNOOZE"
    action:
      - service: input_number.set_value
        target:
          entity_id: input_number.insuline_snoozes
        data:
          value: "{{ states('input_number.insuline_snoozes') | int(0) + 1 }}"
      - service: timer.start
        target:
          entity_id: timer.insuline_relance
        data:
          duration: "00:15:00"
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: "⏱️ OK, je te re-pingue dans 15 min. (snooze #{{ states('input_number.insuline_snoozes') | int(0) }})"

  # ═══ MIRA — Amodip ½ cp, le SOIR, 1 jour sur 2 (réf ON = 14/06/2026) ═══════
  # Jour ON si (now().toordinal() - 739781) % 2 == 0  (14/06=ON, 15=off, 16=ON…)

  # M1) Déclencheur 20h les jours ON ────────────────────────────────────────
  - id: mira_amodip_soir
    alias: 💊 Mira - Amodip soir 20h (1j/2)
    trigger:
      - platform: time
        at: "20:00:00"
    condition:
      - condition: template
        value_template: "{{ (now().toordinal() - 739781) % 2 == 0 }}"
      - condition: state
        entity_id: input_boolean.mira_amodip_faite
        state: "off"
      - condition: state
        entity_id: input_boolean.mira_en_cours
        state: "off"
    action:
      - service: script.mira_envoyer_nudge

  # M2) ESCALADE Mira (relance 15 min jusqu'à confirmation) ──────────────────
  - id: mira_escalade
    alias: 💊 Mira - Escalade (relance 15 min)
    trigger:
      - platform: event
        event_type: timer.finished
        event_data:
          entity_id: timer.mira_relance
    condition:
      - condition: state
        entity_id: input_boolean.mira_en_cours
        state: "on"
    action:
      - service: input_boolean.turn_on
        target:
          entity_id: input_boolean.mira_escalade_declenchee
      - service: script.mira_envoyer_nudge
        data:
          relance: true

  # M3) Handler « Fait ✅ » (callback /MIRA_OK) ─────────────────────────────
  - id: mira_handler_fait
    alias: 💊 Mira - Handler « Fait »
    trigger:
      - platform: event
        event_type: telegram_callback
        event_data:
          data: "/MIRA_OK"
    action:
      - service: timer.cancel
        target:
          entity_id: timer.mira_relance
      - service: pyscript.log_insuline
        data:
          moment: "mira"
          source: "soir_1j2"
          snoozes: "{{ states('input_number.mira_snoozes') | int(0) }}"
          en_retard: "{{ is_state('input_boolean.mira_escalade_declenchee', 'on') }}"
      - service: input_boolean.turn_on
        target:
          entity_id: input_boolean.mira_amodip_faite
      - service: input_boolean.turn_off
        target:
          entity_id:
            - input_boolean.mira_en_cours
            - input_boolean.mira_escalade_declenchee
      - service: input_number.set_value
        target:
          entity_id: input_number.mira_snoozes
        data:
          value: 0
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: "✅ Noté. Amodip de Mira loggé. 🐾"

  # M4) Handler « Snooze ⏱️ » (callback /MIRA_SNOOZE) ───────────────────────
  - id: mira_handler_snooze
    alias: 💊 Mira - Handler « Snooze »
    trigger:
      - platform: event
        event_type: telegram_callback
        event_data:
          data: "/MIRA_SNOOZE"
    action:
      - service: input_number.set_value
        target:
          entity_id: input_number.mira_snoozes
        data:
          value: "{{ states('input_number.mira_snoozes') | int(0) + 1 }}"
      - service: timer.start
        target:
          entity_id: timer.mira_relance
        data:
          duration: "00:15:00"
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: "⏱️ OK, je te re-pingue dans 15 min pour l'Amodip de Mira. (snooze #{{ states('input_number.mira_snoozes') | int(0) }})"

  # ═══ CHRIS — traitements perso (matin sur lever Sonos + soir 23h) ═════════
  # Matin (Ritaline, NAC, Oméga 3, Multivit) : déclenché dans l'automation
  # « Détection lever (Sonos) » ci-dessus. Filet 9h30 ci-dessous.
  # Soir (Lyrica, Sertraline, NAC, 2 Magnésium) : 23h fixe.

  # C1) Filet matin 9h30 (week-end / Sonos muet) ────────────────────────────
  - id: chris_filet_matin_0930
    alias: 🧑 Chris - Filet médocs matin 9h30
    trigger:
      - platform: time
        at: "09:30:00"
    condition:
      - condition: state
        entity_id: input_boolean.chris_matin_faite
        state: "off"
    action:
      - service: script.chris_envoyer_nudge
        data:
          moment: "matin"

  # C2) Déclencheur SOIR 23h ─────────────────────────────────────────────────
  - id: chris_medocs_soir_23h
    alias: 🧑 Chris - Médocs soir 23h
    trigger:
      - platform: time
        at: "23:00:00"
    condition:
      - condition: state
        entity_id: input_boolean.chris_soir_faite
        state: "off"
      - condition: state
        entity_id: input_boolean.chris_en_cours
        state: "off"
    action:
      - service: script.chris_envoyer_nudge
        data:
          moment: "soir"

  # C3) ESCALADE Chris (relance 15 min jusqu'à confirmation) ─────────────────
  - id: chris_escalade
    alias: 🧑 Chris - Escalade (relance 15 min)
    trigger:
      - platform: event
        event_type: timer.finished
        event_data:
          entity_id: timer.chris_relance
    condition:
      - condition: state
        entity_id: input_boolean.chris_en_cours
        state: "on"
    action:
      - service: input_boolean.turn_on
        target:
          entity_id: input_boolean.chris_escalade_declenchee
      - service: script.chris_envoyer_nudge
        data:
          moment: "{{ states('input_text.chris_moment_courant') }}"
          relance: true

  # C4) Handler « Fait ✅ » (callback /CHRIS_OK) ────────────────────────────
  - id: chris_handler_fait
    alias: 🧑 Chris - Handler « Fait »
    trigger:
      - platform: event
        event_type: telegram_callback
        event_data:
          data: "/CHRIS_OK"
    action:
      - service: timer.cancel
        target:
          entity_id: timer.chris_relance
      - service: pyscript.log_insuline
        data:
          moment: "chris_{{ states('input_text.chris_moment_courant') }}"
          source: "perso"
          snoozes: "{{ states('input_number.chris_snoozes') | int(0) }}"
          en_retard: "{{ is_state('input_boolean.chris_escalade_declenchee', 'on') }}"
      - choose:
          - conditions:
              - condition: template
                value_template: "{{ states('input_text.chris_moment_courant') == 'matin' }}"
            sequence:
              - service: input_boolean.turn_on
                target:
                  entity_id: input_boolean.chris_matin_faite
          - conditions:
              - condition: template
                value_template: "{{ states('input_text.chris_moment_courant') == 'soir' }}"
            sequence:
              - service: input_boolean.turn_on
                target:
                  entity_id: input_boolean.chris_soir_faite
      - service: input_boolean.turn_off
        target:
          entity_id:
            - input_boolean.chris_en_cours
            - input_boolean.chris_escalade_declenchee
      - service: input_number.set_value
        target:
          entity_id: input_number.chris_snoozes
        data:
          value: 0
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: "✅ Noté. Tes médocs {{ states('input_text.chris_moment_courant') }} sont loggés. 👍"

  # C5) Handler « Snooze ⏱️ » (callback /CHRIS_SNOOZE) ──────────────────────
  - id: chris_handler_snooze
    alias: 🧑 Chris - Handler « Snooze »
    trigger:
      - platform: event
        event_type: telegram_callback
        event_data:
          data: "/CHRIS_SNOOZE"
    action:
      - service: input_number.set_value
        target:
          entity_id: input_number.chris_snoozes
        data:
          value: "{{ states('input_number.chris_snoozes') | int(0) + 1 }}"
      - service: timer.start
        target:
          entity_id: timer.chris_relance
        data:
          duration: "00:15:00"
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: "⏱️ OK, je te re-pingue dans 15 min pour tes médocs. (snooze #{{ states('input_number.chris_snoozes') | int(0) }})"

  # ═══ CHATS — rappel mensuel (1er) : antipuce + filtre fontaine ════════════
  # Handler « Fait ✅ » (callback /CHATS_OK)
  - id: chats_handler_fait
    alias: 🐱 Chats - Handler « Fait » (mensuel)
    trigger:
      - platform: event
        event_type: telegram_callback
        event_data:
          data: "/CHATS_OK"
    action:
      - service: input_boolean.turn_on
        target:
          entity_id: input_boolean.chats_mensuel_fait
      - service: pyscript.log_insuline
        data:
          moment: "chats_mensuel"
          source: "1er_du_mois"
          snoozes: 0
          en_retard: false
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: "✅ Noté : antipuce + filtre fontaine faits ce mois. 🐾"

  # ═══ MÉNAGE — soft neutre, « une chose, ton choix » (lun/mer 18h, sam 11h) ═
  - id: menage_soft
    alias: 🧹 Ménage - Rappel soft
    trigger:
      - platform: time
        at: "18:00:00"
        id: semaine
      - platform: time
        at: "11:00:00"
        id: samedi
    condition:
      - condition: template
        value_template: >-
          {% set d = now().weekday() %}
          {{ (trigger.id == 'semaine' and d in [0, 2])
             or (trigger.id == 'samedi' and d == 5) }}
    action:
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: >-
            🧹 Petite tâche du jour : choisis UN truc de ménage et fais-le. Juste un. 👌

  # ═══ HYDRATATION/REPAS — contextuel : 3h de stream continu ════════════════
  # Contexte (pas l'horloge) : PC Salon > 100W sans interruption pendant 3h.
  # UN SEUL nudge par session ; réarmé quand le PC redescend (fin de stream).
  # Plage 08h–01h (jamais la nuit). JAMAIS « va te coucher » — hydrate/mange.

  # H1) 3h de stream continu → nudge (si pas déjà envoyé cette session) ───────
  - id: hydratation_stream_3h
    alias: 🥤 Hydratation - 3h de stream
    trigger:
      - platform: numeric_state
        entity_id: sensor.shellyemminig4_d885acef3f88_puissance
        above: 100
        for: "03:00:00"
    condition:
      # plage autorisée : PAS entre 01h et 08h
      - condition: time
        after: "08:00:00"
        before: "01:00:00"
      - condition: state
        entity_id: input_boolean.hydratation_nudge_envoye
        state: "off"
    action:
      - service: input_boolean.turn_on
        target:
          entity_id: input_boolean.hydratation_nudge_envoye
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: >-
            🥤 Ça fait 3h de stream non-stop. Bois un grand verre d'eau
            et grignote un truc. 💪
          inline_keyboard:
            - "Fait ✅:/HYDRAT_OK"

  # H2) Réarme quand le PC redescend (fin de session = prochain nudge possible) ─
  - id: hydratation_reset_fin_stream
    alias: 🥤 Hydratation - Reset fin de stream
    trigger:
      - platform: numeric_state
        entity_id: sensor.shellyemminig4_d885acef3f88_puissance
        below: 100
        for: "00:10:00"          # 10 min sous 100W = vraie fin de session
    action:
      - service: input_boolean.turn_off
        target:
          entity_id: input_boolean.hydratation_nudge_envoye

  # H3) Handler « Fait ✅ » (callback /HYDRAT_OK) — log, pas d'escalade ───────
  - id: hydratation_handler_fait
    alias: 🥤 Hydratation - Handler « Fait »
    trigger:
      - platform: event
        event_type: telegram_callback
        event_data:
          data: "/HYDRAT_OK"
    action:
      - service: pyscript.log_insuline
        data:
          moment: "hydratation"
          source: "stream_3h"
          snoozes: 0
          en_retard: false
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: "✅ Bien joué. Hydrate-toi régulièrement. 💧"

# ── Script d'envoi du nudge (réutilisé matin / soir / relance) ───────────────
script:
  insuline_envoyer_nudge:
    alias: 💉 Insuline - Envoyer le nudge
    mode: single
    fields:
      moment:
        description: "matin ou soir"
      source:
        description: "sonos | filet_0930 | plus12h | manuel"
      relance:
        description: "true si c'est une relance d'escalade"
        default: false
    sequence:
      # mémorise le contexte courant (lu par escalade / handlers)
      - service: input_text.set_value
        target:
          entity_id: input_text.insuline_moment_courant
        data:
          value: "{{ moment }}"
      - service: input_text.set_value
        target:
          entity_id: input_text.insuline_source_courante
        data:
          value: "{{ source }}"
      - service: input_boolean.turn_on
        target:
          entity_id: input_boolean.insuline_en_cours
      # message : absent vs présent
      - choose:
          - conditions:
              - condition: state
                entity_id: binary_sensor.presence_maison
                state: "off"
            sequence:
              - service: telegram_bot.send_message
                data:
                  config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
                  message: >-
                    🚨 T'es DEHORS et c'est l'heure de l'insuline de Wolverine ({{ moment }}).
                    Qui s'en occupe ? Préviens quelqu'un ou rentre. 💉🐾
                  inline_keyboard:
                    - "Fait ✅:/INSU_OK, Snooze 15min ⏱️:/INSU_SNOOZE"
        default:
          - service: telegram_bot.send_message
            data:
              config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
              message: >-
                {% if relance %}⚠️ Toujours pas confirmée — {% endif %}💉 Insuline Wolverine ({{ moment }}). Pique et confirme.
              inline_keyboard:
                - "Fait ✅:/INSU_OK, Snooze 15min ⏱️:/INSU_SNOOZE"
      # (re)démarre le timer d'escalade : relance dans 15 min si pas de clic
      - service: timer.start
        target:
          entity_id: timer.insuline_relance
        data:
          duration: "00:15:00"

  mira_envoyer_nudge:
    alias: 💊 Mira - Envoyer le nudge
    mode: single
    fields:
      relance:
        description: "true si c'est une relance d'escalade"
        default: false
    sequence:
      - service: input_boolean.turn_on
        target:
          entity_id: input_boolean.mira_en_cours
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: >-
            {% if relance %}⚠️ Toujours pas confirmé — {% endif %}💊 Mira : ½ Amodip (1 jour sur 2). Donne et confirme.
          inline_keyboard:
            - "Fait ✅:/MIRA_OK, Snooze 15min ⏱️:/MIRA_SNOOZE"
      - service: timer.start
        target:
          entity_id: timer.mira_relance
        data:
          duration: "00:15:00"

  chris_envoyer_nudge:
    alias: 🧑 Chris - Envoyer le nudge médocs
    mode: single
    fields:
      moment:
        description: "matin ou soir"
      relance:
        description: "true si c'est une relance d'escalade"
        default: false
    sequence:
      - service: input_text.set_value
        target:
          entity_id: input_text.chris_moment_courant
        data:
          value: "{{ moment }}"
      - service: input_boolean.turn_on
        target:
          entity_id: input_boolean.chris_en_cours
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: >-
            {% if relance %}⚠️ Toujours pas pris — {% endif %}🧑 Tes médocs du {{ moment }} :
            {% if moment == 'matin' %}1 Ritaline · 1 NAC · 1 Oméga 3 · 1 Multivitamine{% else %}1 Lyrica · 1 Sertraline · 1 NAC · 2 Magnésium{% endif %}.
            Prends et confirme.
          inline_keyboard:
            - "Fait ✅:/CHRIS_OK, Snooze 15min ⏱️:/CHRIS_SNOOZE"
      - service: timer.start
        target:
          entity_id: timer.chris_relance
        data:
          duration: "00:15:00"

  chats_envoyer_nudge_mensuel:
    alias: 🐱 Chats - Nudge mensuel (antipuce + filtre fontaine)
    mode: single
    sequence:
      - service: telegram_bot.send_message
        data:
          config_entry_id: 01KV0GBSBGNVQCHFJGRFERM7TY
          message: >-
            🐱 Début de mois — pour Wolverine & Mira :
            🐛 antipuce des chats · 💧 changer le filtre de la fontaine à eau.
            Confirme quand c'est fait.
          inline_keyboard:
            - "Fait ✅:/CHATS_OK"
