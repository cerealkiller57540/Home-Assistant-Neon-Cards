    if (fxOn && STORM_CONDS.has(cond)) this._startStorm(); else this._stopStorm();
    // NUIT CLAIRE → étoiles filantes one-shot par rafales
    if (fxOn && NIGHT_CONDS.has(cond)) this._startNight(); else this._stopNight();
