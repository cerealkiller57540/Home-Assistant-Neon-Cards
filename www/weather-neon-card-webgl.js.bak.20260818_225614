const KANJI = {
  sunny: '晴', 'clear-night': '夜', partlycloudy: '時', 'partlycloudy-night': '夜',
  cloudy: '曇', rainy: '雨', 'rainy-night': '雨', pouring: '雨', lightning: '雷',
