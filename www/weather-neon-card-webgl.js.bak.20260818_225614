  float gradient=pow(max(opacity,1e-4), max(uFrSteep-(uFrAmt*uFrSteep),0.0))*uFrAmt;
  gradient*=smoothstep(0.0,0.02,opacity);
  density*=gradient; opacity*=gradient;
