        "uSvgOff",
        "uSvgSize",
        "uTime",
        "uCrackle",
        "uRate",
        "uAmp",
        "uSpill",
        "uCore",
        "uHalo",
        "uGriz",
        "uSparkN",
        "uBreath",
        "uDither",
        "uDir",
        "uGC1",
        "uGC2",
