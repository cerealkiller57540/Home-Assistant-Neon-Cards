      gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, false);
      gl.enable(gl.BLEND);
      gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
      gl.uniform1i(this.u.uField, 0);
    }
    setSeams(fld) {
      const gl = this.gl;
      gl.bindTexture(gl.TEXTURE_2D, this.tex);
